{
  "name": "web3-api",
  "version": "1.0.0",
  "description": "Web3 API for interacting with smart contracts",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "compile:contracts": "node scripts/compile-contracts.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "npm run test:performance",
    "test:performance": "hardhat run --no-compile tests/run-performance-test.js",
    "node:local": "hardhat node",
    "deploy:local": "hardhat run --no-compile scripts/deploy-local.js --network localhost",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ethers": "^6.0.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "hardhat": "^2.26.0",
    "solc": "^0.8.35",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
